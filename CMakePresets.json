{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Default build using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/cmake_targets/ran_build/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "ENABLE_TF5": "ON"
            }
        },
        {
            "name": "tests",
            "displayName": "Default unit test config",
            "inherits": "default",
            "binaryDir": "${sourceDir}/cmake_targets/ran_build/build_test",
            "cacheVariables": {
                "ENABLE_TESTS": "ON",
                "ENABLE_TF5": "ON",
                "SANITIZE_ADDRESS": "ON",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug build",
            "inherits": "default",
            "binaryDir": "${sourceDir}/cmake_targets/ran_build/build_debug",
            "cacheVariables": {
                "ENABLE_TESTS": "ON",
                "ENABLE_TF5": "ON",
                "SANITIZE_ADDRESS": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "5gdefault",
            "configurePreset": "default",
            "targets": [
                "nr-uesoftmodem",
                "nr-softmodem",
                "rfsimulator",
                "vrtsim",
                "dfts",
                "ldpc",
                "params_libconfig",
                "params_yaml"
            ]
        },
        {
            "name": "default",
            "inherits": "5gdefault"
        },
        {
            "name": "4gdefault",
            "configurePreset": "default",
            "targets": [
                "lte-softmodem",
                "lte-uesoftmodem",
                "dfts",
                "coding",
                "rfsimulator",
                "params_libconfig"
            ]
        },
        {
            "name": "tests",
            "configurePreset": "tests",
            "targets": [
                "tests"
            ]
        },
        {
            "name": "tf5_tests",
            "configurePreset": "tests",
            "targets": [
                "tf5_tests"
            ]
        }
    ]
}
