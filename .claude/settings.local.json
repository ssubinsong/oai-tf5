{
  "permissions": {
    "allow": [
      "Bash(ctest:*)",
      "Bash(grep:*)",
      "mcp__plugin_serena_serena__list_dir",
      "mcp__plugin_serena_serena__jet_brains_get_symbols_overview",
      "mcp__serena__read_memory",
      "mcp__serena__list_dir",
      "mcp__serena__jet_brains_get_symbols_overview",
      "mcp__serena__search_for_pattern",
      "mcp__serena__find_file",
      "mcp__serena__jet_brains_find_symbol",
      "mcp__serena__rename_symbol",
      "mcp__serena__initial_instructions",
      "mcp__serena__check_onboarding_performed",
      "mcp__zotero__zotero_search_items",
      "mcp__zotero__zotero_get_item_fulltext",
      "Bash(./openair3/SECU/tests/test_tf5_:*)",
      "Bash(cmake --build --preset tf5_tests:*)",
      "Bash(cmake --preset:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "filepath=$(echo \"$CLAUDE_FILE_PATHS\" | tr ',' '\\n' | head -1); if echo \"$filepath\" | grep -qE 'openair3/SECU/tf5_.*\\.(c|h)$'; then echo '[TF5] Source file modified. Run /tf5-build to verify.'; fi",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "filepath=$(echo \"$CLAUDE_FILE_PATHS\" | tr ',' '\\n' | head -1); if echo \"$filepath\" | grep -qE '\\.(c|h|cpp)$' && ! echo \"$filepath\" | grep -q 'tf5' && ! echo \"$filepath\" | grep -q '.claude/'; then echo 'WARNING: Editing non-TF5 OAI source file. This may cause upstream merge conflicts.' >&2; fi",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
